[Unit]
Description=DermaScan IoT Raspberry Pi 3 DHT11 Telemetry Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/iot/raspberry_pi
EnvironmentFile=/home/pi/iot/raspberry_pi/.env
ExecStart=/home/pi/iot/raspberry_pi/.venv/bin/python3 send_sensor.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
