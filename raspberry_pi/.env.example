# ==============================================================================
# DermaScan IoT — Raspberry Pi 3 Environment Configuration (.env.example)
# Copy this file to .env on your Raspberry Pi:
#   cp .env.example .env
#   chmod 600 .env
# ==============================================================================

# Target HTTPS URL of the deployed Vercel backend
SERVER_URL=https://iot-software.vercel.app/api/sensor

# Secret API token for device authentication
# Must match the SENSOR_API_TOKEN configured in your Vercel Project Environment Variables!
# Generate a strong token (e.g., openssl rand -hex 24)
SENSOR_API_TOKEN=your_secure_random_sensor_api_token_here

# Hardware Device Identifier
DEVICE_ID=skin-monitor-pi

# Telemetry transmission cadence in seconds (default: 15)
SENSOR_INTERVAL_SECONDS=15

# Network request timeout in seconds (default: 10.0)
HTTP_TIMEOUT_SECONDS=10.0

# Maximum read attempts per cycle before skipping a transient sensor glitch (default: 3)
MAX_READ_RETRIES=3
